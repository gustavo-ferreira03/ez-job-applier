# Copy this file to `.env` and adjust as needed.
# `docker compose` automatically reads `.env` from this directory.
# Everything here is optional: the defaults below match a plain local run.

# Base URL the browser uses to reach the backend API and noVNC.
# Change it only if the API is served from a different host/port than localhost:3000.
PUBLIC_API_URL=http://localhost:3000

# GitHub OAuth app credentials, required only for GitHub resume sync.
# Create a dedicated OAuth app and keep the secret private.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
